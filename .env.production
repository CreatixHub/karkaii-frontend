# Production build (`npm run build`). Only VITE_* values reach the bundle - they are PUBLIC.
#
# PROTOTYPE / STANDALONE MODE (current): the build runs on its own with built-in sample data - no API required.
VITE_APP_ENV=production
VITE_USE_MOCK_API=true
VITE_AUTH_ENABLED=false

# --- When the API is deployed, change to: ----------------------------------------------------------------------
#   VITE_USE_MOCK_API=false
#   VITE_AUTH_ENABLED=true
#   VITE_API_BASE_URL=/api      (same-origin: nginx forwards /api to the Express server, see deploy/README.md)

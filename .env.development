# Local development. Only VITE_* values reach the browser bundle - they are PUBLIC, never put secrets here.
#
# PROTOTYPE / STANDALONE MODE (current): no server needed. All pages use built-in sample data and nothing is
# locked behind a login, exactly like the original template.
VITE_APP_ENV=development
VITE_USE_MOCK_API=true
VITE_AUTH_ENABLED=false

# --- To connect the real API later, change the three lines above to: -----------------------------------------
#   VITE_USE_MOCK_API=false
#   VITE_AUTH_ENABLED=true
#   VITE_API_BASE_URL=/api
# then start the API (`cd server && npm run dev:memory`). The dev server proxies /api and /uploads to it.
# Dev-only (read by vite.config.ts, not bundled): where the backend runs.
API_PROXY_TARGET=http://localhost:5000

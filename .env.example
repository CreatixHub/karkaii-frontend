# Copy to .env.local to override the committed .env.development / .env.production for your machine.
# Only VITE_* values reach the browser bundle - they are PUBLIC. Never put secrets here.

VITE_APP_ENV=development            # development | staging | production
VITE_API_BASE_URL=/api              # same-origin in dev (proxy) and production (nginx); or a full URL if the API is elsewhere
VITE_USE_MOCK_API=false             # true = built-in mock data, no backend needed
VITE_AUTH_ENABLED=true              # true = routes require a signed-in session
# VITE_API_TIMEOUT=15000

# Dev-only (read by vite.config.ts): where `npm run dev` forwards /api and /uploads
# API_PROXY_TARGET=http://localhost:5000
